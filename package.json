{
  "name": "giancastle",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @giancastle/web dev",
    "dev:blog": "pnpm --filter @giancastle/blog dev",
    "dev:ui": "pnpm --filter @giancastle/ui-site dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cv:pdf": "pnpm --filter @giancastle/web cv:pdf"
  },
  "devDependencies": {
    "prettier": "latest",
    "prettier-plugin-astro": "latest"
  }
}
