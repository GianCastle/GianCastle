---
import {
  PLATE_ATTR,
  PLATE_NUMBER_WIDTH,
  type PlateLabels,
  type PlateLink,
  type PlateSection,
} from '../section-plate';
import { TONE } from '../theme';

interface Props {
  sections: readonly PlateSection[];
  labels: PlateLabels;
  links?: readonly PlateLink[];
}

const { sections, labels, links = [] } = Astro.props;
const LIST_ID = 'section-plate-list';

const items = sections.map((section, index) => ({
  ...section,
  number: String(index + 1).padStart(PLATE_NUMBER_WIDTH, '0'),
  position: labels.position(index + 1, sections.length),
}));
const [first] = items;
---

{first && (
  <div class="plate" {...{ [PLATE_ATTR.root]: '' }} data-tone={TONE.contrast} inert>
    <button class="toggle" type="button" aria-expanded="false" aria-controls={LIST_ID}>
      <span class="heavy number" {...{ [PLATE_ATTR.number]: '' }}>
        {first.number}
      </span>
      <span class="info">
        <span class="label position" {...{ [PLATE_ATTR.position]: '' }}>
          {first.position}
        </span>
        <span class="label name" {...{ [PLATE_ATTR.name]: '' }}>
          {first.label}
        </span>
      </span>
    </button>
    <nav id={LIST_ID} class="list" aria-label={labels.nav} hidden>
      {items.map(item => (
        <a
          href={`#${item.id}`}
          {...{
            [PLATE_ATTR.link]: '',
            [PLATE_ATTR.itemNumber]: item.number,
            [PLATE_ATTR.itemPosition]: item.position,
          }}
        >
          <span class="heavy">{item.number}</span>
          <span class="label" {...{ [PLATE_ATTR.label]: '' }}>
            {item.label}
          </span>
        </a>
      ))}
      {links.map(link => (
        <a class="extra" href={link.href}>
          <span class="label">{link.label}</span>
          <i class="arrow" aria-hidden="true" />
        </a>
      ))}
      <a class="heavy contact" href={labels.contact.href}>
        {labels.contact.label}
      </a>
    </nav>
  </div>
)}

<script>
  import { initSectionPlates } from '../section-plate.client';

  initSectionPlates();
</script>

<style>
  .plate {
    position: fixed;
    right: var(--gutter);
    top: 1rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    opacity: 0;
    translate: 0 -150%;
    rotate: 1.5deg;
    transition:
      opacity 250ms,
      translate 350ms var(--ease-out);
  }

  .plate[data-visible] {
    opacity: 1;
    translate: 0 0;
  }

  .toggle {
    display: flex;
    align-items: stretch;
    min-height: 3.5rem;
    padding: 0;
    border: 0;
    background: var(--fg);
    color: var(--bg);
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 0 0 3px var(--bg);
  }

  .toggle:focus-visible,
  .list a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .number {
    display: flex;
    align-items: center;
    padding: 0 0.85rem;
    font-size: 2.5rem;
    line-height: 1;
  }

  .info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    padding: 0 1rem;
    background: var(--accent-solid);
    color: var(--on-accent);
  }

  .position {
    font-size: 0.56rem;
  }

  .list {
    display: flex;
    flex-direction: column;
    width: min(18.75rem, calc(100vw - 2 * var(--gutter)));
    margin-top: 0.6rem;
    background: var(--fg);
    color: var(--bg);
    box-shadow: 0 0 0 3px var(--bg);
  }

  .list[hidden] {
    display: none;
  }

  .list a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.25rem;
    padding: 0 1rem;
    border-bottom: 2px solid var(--bg);
    color: inherit;
    text-decoration: none;
  }

  .list a .heavy {
    width: 2.1rem;
    font-size: 1.9rem;
    line-height: 1;
  }

  .list a[aria-current],
  .list a:hover {
    background: var(--accent-solid);
    color: var(--on-accent);
  }

  .list .extra {
    justify-content: space-between;
  }

  .arrow {
    width: 0.7rem;
    height: 0.9rem;
    background: currentColor;
    clip-path: var(--clip-chevron);
  }

  .list .contact {
    justify-content: center;
    border-bottom: 0;
    background: var(--mark-bg);
    color: var(--mark-fg);
    font-size: 1.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .plate {
      transition: none;
    }
  }
</style>
