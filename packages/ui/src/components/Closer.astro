---
import type { Locale } from '../locale';
import type { PlateSection } from '../section-plate';
import type { Site } from '../sites';
import { TONE } from '../theme';
import Band from './Band.astro';
import DecalStrip from './DecalStrip.astro';
import FooterNav from './FooterNav.astro';
import Heavy from './Heavy.astro';

interface Props {
  site: Site;
  locale: Locale;
  sections?: readonly PlateSection[];
  title: string;
  tagline?: string;
  note?: string;
  colophon?: string;
}

const { site, locale, sections, title, tagline, note, colophon } = Astro.props;
---

<Band as="footer" tone={TONE.contrast}>
  <div class="strip">
    <DecalStrip />
  </div>
  <Heavy size="closer">
    {title}
    <sup>*</sup>
  </Heavy>
  {tagline && <p class="lede tagline">{tagline}</p>}
  <div class="nav">
    <FooterNav site={site} locale={locale} sections={sections}>
      <slot />
    </FooterNav>
  </div>
  {note && <p class="note">{note}</p>}
  {colophon && <p class="label colophon">{colophon}</p>}
</Band>

<style>
  .strip {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  sup {
    font-size: 0.45em;
    vertical-align: top;
    line-height: 1;
    color: var(--accent);
  }

  .tagline {
    max-width: 22ch;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .nav {
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .note {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 70ch;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .colophon {
    margin-top: 1.5rem;
    color: var(--muted);
  }
</style>
