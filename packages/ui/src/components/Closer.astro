---
import { TONE } from '../theme';
import Band from './Band.astro';
import DecalStrip from './DecalStrip.astro';
import Heavy from './Heavy.astro';

interface Props {
  title: string;
  tagline?: string;
  note?: string;
  colophon?: string;
}

const { title, tagline, note, colophon } = Astro.props;
---

<Band as="footer" tone={TONE.contrast}>
  <div class="strip">
    <DecalStrip />
  </div>
  <Heavy size="closer">
    {title}
    <sup>*</sup>
  </Heavy>
  <div class="row">
    {tagline && <p class="lede tagline">{tagline}</p>}
    <slot />
  </div>
  {note && <p class="note rule-top">{note}</p>}
  {colophon && <p class="label colophon">{colophon}</p>}
</Band>

<style>
  .strip {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  sup {
    font-size: 0.45em;
    vertical-align: top;
    line-height: 1;
    color: var(--accent);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .tagline {
    max-width: 22ch;
  }

  .note {
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-top: 1.25rem;
    max-width: 70ch;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .colophon {
    margin-top: 1.5rem;
    color: var(--muted);
  }
</style>
