---
import Heavy from './Heavy.astro';

interface Props {
  items: readonly { lead: string; trail: string; body: string }[];
}

const { items } = Astro.props;
---

<ul class="statements">
  {items.map(item => (
    <li class="rule-top">
      <Heavy size="figure">
        {item.lead} <span class="slash">/</span> {item.trail}
      </Heavy>
      <p>{item.body}</p>
    </li>
  ))}
</ul>

<style>
  .statements {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 1fr minmax(14rem, 22rem);
    align-items: end;
    gap: 1rem 3rem;
    padding: clamp(1.5rem, 3vw, 2.75rem) 0;
  }

  .slash {
    margin-inline: 0.16em 0.04em;
    color: var(--accent-soft);
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
