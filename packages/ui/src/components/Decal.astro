---
import { DECAL_SHAPE, type DecalColor, type DecalShape } from '../decals';

interface Props {
  shape?: DecalShape;
  color?: DecalColor;
  size?: string;
  rotate?: number;
}

const { shape = DECAL_SHAPE.square, color, size = '0.6em', rotate = 0 } = Astro.props;
const style = `width:${size};height:${size};rotate:${rotate}deg`;
---

<i class:list={['decal', `decal-${shape}`]} data-decal={color} style={style} aria-hidden="true"></i>
