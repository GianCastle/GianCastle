---
import { STAGE_OWNER_FILL, type Stage } from '../stages';
import Heavy from './Heavy.astro';

interface Props {
  stages: readonly Stage[];
  finishLabel: string;
}

const VIEW = { width: 1000, height: 150 } as const;

const PROFILE_POINTS = [
  [0, 120],
  [60, 96],
  [120, 108],
  [200, 70],
  [270, 92],
  [330, 60],
  [400, 34],
  [470, 20],
  [520, 44],
  [600, 16],
  [660, 40],
  [720, 58],
  [800, 88],
  [860, 74],
  [930, 110],
  [1000, 124],
] as const;

const { stages, finishLabel } = Astro.props;

const ridge = PROFILE_POINTS.map(([x, y]) => `${x} ${y}`).join(' L');
const outline = `M${ridge}`;
const area = `M0 ${VIEW.height} L${ridge} L${VIEW.width} ${VIEW.height} Z`;

const heightAt = (x: number) => {
  const next = PROFILE_POINTS.findIndex(([px]) => px >= x);
  const [x1, y1] = PROFILE_POINTS[Math.max(next, 1)] ?? [VIEW.width, VIEW.height];
  const [x0, y0] = PROFILE_POINTS[Math.max(next, 1) - 1] ?? [0, VIEW.height];
  return y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
};

const markers = stages.map((stage, index) => {
  const x = (VIEW.width / stages.length) * index;
  return {
    left: `calc((100% - var(--finish-width)) * ${x / VIEW.width})`,
    top: `${(heightAt(x) / VIEW.height) * 100}%`,
    fill: STAGE_OWNER_FILL[stage.owner],
  };
});
---

<div class="profile">
  <div class="chart" aria-hidden="true">
    <svg viewBox={`0 0 ${VIEW.width} ${VIEW.height}`} preserveAspectRatio="none">
      <path class="area" d={area}></path>
      <path class="ridge" d={outline} vector-effect="non-scaling-stroke"></path>
    </svg>
    {markers.map(marker => (
      <i class="marker" style={`left:${marker.left};top:${marker.top};background:${marker.fill}`} />
    ))}
    <div class="finish">
      <span class="label flag">{finishLabel}</span>
      <i class="post"></i>
    </div>
  </div>
  <ol class="stages">
    {stages.map(stage => (
      <li>
        <span class="label tag" style={`background:${STAGE_OWNER_FILL[stage.owner]}`}>
          {stage.tag}
        </span>
        <Heavy as="h3" size="step">
          {stage.title}
        </Heavy>
        <p>{stage.body}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .profile {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .chart {
    --finish-width: 1.5rem;
    position: relative;
    margin-top: 1.75rem;
    padding-right: var(--finish-width);
  }

  svg {
    display: block;
    width: 100%;
    height: clamp(5rem, 13vw, 12rem);
  }

  .area {
    fill: var(--raise);
  }

  .ridge {
    fill: none;
    stroke: var(--fg);
    stroke-width: 3;
  }

  .marker {
    position: absolute;
    width: 0.9rem;
    height: 0.9rem;
    translate: 0 -50%;
  }

  .finish {
    position: absolute;
    right: 0;
    top: -1.75rem;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .flag {
    padding: 0.4em 0.75em;
    background: var(--fg);
    color: var(--bg);
    white-space: nowrap;
  }

  .post {
    flex: 1;
    width: var(--finish-width);
    background: conic-gradient(var(--fg) 25%, var(--bg) 0 50%, var(--fg) 0 75%, var(--bg) 0) 0 0 /
      0.75rem 0.75rem;
    border: 2px solid var(--fg);
  }

  .stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 2.25rem 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .stages li {
    container-type: inline-size;
  }

  .stages :global(h3) {
    font-size: clamp(1.8rem, 19cqi, 5.5rem);
  }

  .tag {
    display: inline-block;
    margin-bottom: 0.8rem;
    padding: 0.4em 0.75em;
    color: var(--ink);
  }

  p {
    margin-top: 0.7rem;
    max-width: 26ch;
  }
</style>
