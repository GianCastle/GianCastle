---
import { DECAL_COLORS, DECAL_SHAPE } from '../decals';
import {
  RACE_NUMBER_ID,
  RACE_NUMBER_PLACEMENTS,
  RACE_NUMBER_STAGGER_MS,
  type RaceNumber,
  type RaceNumberLabels,
} from '../race-numbers';
import Chevrons from './Chevrons.astro';
import Dashes from './Dashes.astro';
import Decal from './Decal.astro';
import FlipIcon from './FlipIcon.astro';

interface Props {
  items: readonly RaceNumber[];
  labels: RaceNumberLabels;
  id?: string;
}

const { items, labels, id = RACE_NUMBER_ID } = Astro.props;

const cards = items.map((item, index) => {
  const placement =
    RACE_NUMBER_PLACEMENTS[index % RACE_NUMBER_PLACEMENTS.length] ?? RACE_NUMBER_PLACEMENTS[0];
  const [first, second] = DECAL_COLORS.filter(color => color !== item.color);
  const ids = {
    number: `${id}-${index}-number`,
    caption: `${id}-${index}-caption`,
    title: `${id}-${index}-title`,
    body: `${id}-${index}-body`,
  };
  return {
    ...item,
    ids,
    placement,
    corner: index % 2 === 0 ? [first, second] : [second, first],
    style: [`--tilt:${placement.tilt}deg`, `--delay:${index * RACE_NUMBER_STAGGER_MS}ms`].join(';'),
  };
});
---

<ul class="numbers" data-race-numbers>
  {cards.map(card => (
    <li>
      <button
        class="card"
        type="button"
        aria-pressed="false"
        data-decal={card.color}
        aria-labelledby={`${card.ids.number} ${card.ids.caption} ${card.ids.title}`}
        aria-describedby={card.ids.body}
        style={card.style}
      >
        <span class="inner">
          <span class="face front">
            <i class="pin top left" />
            <i class="pin top right" />
            <i class="pin bottom left" />
            <i class="pin bottom right" />
            <span class="corner" aria-hidden="true">
              <Decal shape={DECAL_SHAPE.square} color={card.corner[0]} size="0.95rem" />
              <Decal
                shape={DECAL_SHAPE.triangle}
                color={card.corner[1]}
                size="1.9rem"
                rotate={22}
              />
            </span>
            <span class="scatter" style={card.placement.chevrons}>
              <Chevrons size="0.75rem" />
            </span>
            <span class="scatter" style={card.placement.dashes}>
              <Dashes size="0.75rem" />
            </span>
            <span id={card.ids.number} class="heavy number">
              {card.number}
            </span>
            <span class="band">
              <span class="label sector">{card.sector}</span>
              <span id={card.ids.caption} class="heavy caption">
                {card.caption}
              </span>
              <span class="label hint">
                {labels.turnOver}
                <FlipIcon />
              </span>
            </span>
          </span>
          <span class="face back">
            <span class="label chip sector">{card.sector}</span>
            <span id={card.ids.title} class="heavy title">
              {card.title}
            </span>
            <span id={card.ids.body} class="body">
              {card.body}
            </span>
            <span class="label hint">
              {labels.turnBack}
              <FlipIcon />
            </span>
          </span>
        </span>
      </button>
    </li>
  ))}
</ul>

<script>
  const lists = document.querySelectorAll('[data-race-numbers]');

  for (const list of lists) {
    list.addEventListener('click', event => {
      const card = (event.target as Element).closest('button');
      if (!card) return;
      card.setAttribute('aria-pressed', String(card.getAttribute('aria-pressed') !== 'true'));
    });

    const observer = new IntersectionObserver(
      entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        list.setAttribute('data-arrived', '');
        observer.disconnect();
      },
      { threshold: 0.15 },
    );
    list.setAttribute('data-waiting', '');
    observer.observe(list);
  }
</script>

<style>
  .numbers {
    display: grid;
    gap: 2.75rem 2.5rem;
    margin-top: 2.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .numbers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    display: grid;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: inherit;
    cursor: pointer;
    perspective: 1400px;
    container-type: inline-size;
    rotate: var(--tilt);
  }

  .card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 6px;
  }

  [data-waiting] .card {
    opacity: 0;
    translate: 0 -2.5rem;
  }

  [data-arrived] .card {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 500ms var(--delay),
      translate 600ms var(--ease-out) var(--delay);
  }

  .inner {
    display: grid;
    min-height: 21.5rem;
    transform-style: preserve-3d;
    transition:
      transform 650ms cubic-bezier(0.3, 1.3, 0.5, 1),
      scale 200ms;
  }

  .card:hover .inner {
    scale: 1.03;
  }

  .card[aria-pressed='true'] .inner {
    transform: rotateY(180deg);
  }

  .face {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    backface-visibility: hidden;
  }

  .front {
    background: var(--fg);
    color: var(--bg);
    text-align: center;
  }

  .back {
    gap: 0.75rem;
    padding: 1.4rem 1.5rem;
    background: var(--raise);
    border: 3px solid var(--decal);
    transform: rotateY(180deg);
  }

  .pin {
    position: absolute;
    width: 0.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--bg);
  }

  .pin.top {
    top: 0.75rem;
  }

  .pin.bottom {
    bottom: 0.75rem;
  }

  .pin.left {
    left: 0.75rem;
  }

  .pin.right {
    right: 0.75rem;
  }

  .corner {
    position: absolute;
    right: -0.75rem;
    top: -0.9rem;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
  }

  @media (max-width: 39.99rem) {
    .corner {
      right: -0.25rem;
    }
  }

  .scatter {
    position: absolute;
    display: flex;
  }

  .band {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin-top: auto;
    padding: 0.85rem 1.9rem 0.8rem;
    background: var(--decal);
    color: var(--pop-fg);
  }

  .front .sector {
    font-size: 0.65rem;
  }

  .front .pin.bottom {
    background: var(--pop-fg);
  }

  .number {
    margin-block: auto;
    padding-top: 0.6rem;
    font-size: min(43cqi, 9.75rem);
    line-height: 0.95;
  }

  .caption {
    font-size: min(7.7cqi, 1.75rem);
    line-height: 1;
    text-wrap: balance;
  }

  .hint {
    font-size: 0.65rem;
  }

  .front .hint {
    opacity: 0.75;
  }

  .back .sector {
    --chip-pad: 0.2rem 0.5rem;
    --chip-bg: var(--decal);
    --chip-fg: var(--pop-fg);
    align-self: flex-start;
  }

  .title {
    font-size: 2.1rem;
    line-height: 0.95;
  }

  .body {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .back .hint {
    margin-top: auto;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .inner,
    [data-arrived] .card {
      transition: none;
    }

    [data-waiting] .card {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
