---
import type { HTMLTag } from 'astro/types';
import ColorChips from './ColorChips.astro';

interface Props {
  as?: HTMLTag;
}

const { as: Tag = 'p' } = Astro.props;
---

<Tag class="label kicker">
  <ColorChips />
  <slot />
</Tag>

<style>
  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75em;
    color: var(--accent);
  }
</style>
