---
import { LOCALE, type Locale, type LocaleAlternate } from '../locale';
import { TONE } from '../theme';
import { UI_COPY } from '../ui.labels';
import CastleMark from './CastleMark.astro';
import Controls from './Controls.astro';

interface Props {
  wordmark: string;
  eyebrow?: string;
  href: string;
  links?: readonly { label: string; href: string }[];
  locale?: Locale;
  alternate?: LocaleAlternate;
}

const { wordmark, eyebrow, href, links = [], locale = LOCALE.en, alternate } = Astro.props;
---

<header class="masthead" data-tone={TONE.contrast}>
  <a class="brand" href={href} data-castle-host>
    {eyebrow && <span class="label chip eyebrow">{eyebrow}</span>}
    <span class="heavy wordmark">{wordmark}</span>
    <span class="badge">
      <CastleMark />
    </span>
  </a>
  <nav aria-label={UI_COPY[locale].primaryNav}>
    {links.map(link => (
      <a class="label" href={link.href}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="controls">
    <Controls locale={locale} alternate={alternate} />
  </div>
</header>

<style>
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 1rem var(--gutter);
  }

  .brand {
    position: relative;
    display: inline-block;
    margin: 0.45rem 1.6rem 0.2rem 0;
    text-decoration: none;
    rotate: -5deg;
  }

  .eyebrow {
    --chip-pad: 0.35em 0.6em 0.3em;
    --chip-bg: var(--mark-bg);
    --chip-fg: var(--mark-fg);
    display: block;
    width: fit-content;
    margin-bottom: 0.3rem;
    font-size: 0.6rem;
  }

  .wordmark {
    display: block;
    font-size: clamp(1.9rem, 9.5vw, 2.6rem);
    line-height: 0.82;
    color: transparent;
    background: linear-gradient(to bottom, var(--fg) 0 46%, var(--orange) 46% 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .badge {
    position: absolute;
    right: -1.5rem;
    top: -0.75rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    aspect-ratio: 1;
    padding: 0.42rem;
    border-radius: 50%;
    background: var(--mark-bg);
    color: var(--mark-fg);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-left: auto;
  }

  .controls {
    display: flex;
  }

  @media (max-width: 56rem) {
    nav {
      order: 1;
      flex-basis: 100%;
      margin-left: 0;
    }

    .controls {
      margin-left: auto;
    }
  }

  nav a.label {
    text-decoration: none;
  }

  nav a.label:hover {
    color: var(--accent);
  }
</style>
