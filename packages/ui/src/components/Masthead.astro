---
import { LOCALE, type Locale, type LocaleAlternate } from '../locale';
import { TONE } from '../theme';
import { UI_COPY } from '../ui.labels';
import Controls from './Controls.astro';

interface Props {
  wordmark: string;
  href: string;
  links?: readonly { label: string; href: string }[];
  locale?: Locale;
  alternate?: LocaleAlternate;
}

const { wordmark, href, links = [], locale = LOCALE.en, alternate } = Astro.props;
---

<header class="masthead" data-tone={TONE.contrast}>
  <a class="heavy wordmark" href={href}>
    {wordmark}
  </a>
  <nav aria-label={UI_COPY[locale].primaryNav}>
    {links.map(link => (
      <a class="label" href={link.href}>
        {link.label}
      </a>
    ))}
    <Controls locale={locale} alternate={alternate} />
  </nav>
</header>

<style>
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1rem var(--gutter);
  }

  .wordmark {
    display: inline-block;
    font-size: 2.1rem;
    line-height: 1;
    text-decoration: none;
    rotate: -3deg;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  nav a.label {
    text-decoration: none;
  }

  nav a.label:hover {
    color: var(--accent);
  }
</style>
