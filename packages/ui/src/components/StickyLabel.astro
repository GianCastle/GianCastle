---
import type { HTMLTag } from 'astro/types';
import type { DecalColor } from '../decals';

const TILT = {
  left: 'left',
  right: 'right',
} as const;

type Tilt = (typeof TILT)[keyof typeof TILT];

interface Props {
  as?: HTMLTag;
  color?: DecalColor;
  tilt?: Tilt;
}

const { as: Tag = 'span', color, tilt = TILT.left } = Astro.props;
---

<Tag class:list={['label', 'chip', 'chip-ring', 'sticky', tilt]} data-decal={color}>
  <slot />
</Tag>

<style>
  .sticky {
    --chip-pad: 0.55em 0.9em 0.5em;
    --chip-bg: var(--fg);
    --chip-fg: var(--bg);
    display: inline-block;
  }

  .sticky[data-decal] {
    --chip-bg: var(--decal);
    --chip-fg: var(--ink);
  }

  .left {
    rotate: -2deg;
  }

  .right {
    rotate: 1.5deg;
  }

  .sticky :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
