---
import { LOCALE } from '@giancastle/ui/locale';
import { getPublishedPosts, groupByTag, type Tag } from '@/features/posts/posts.query';
import TagView from '@/features/posts/views/TagView.astro';

export const getStaticPaths = async () => {
  const tags = groupByTag(await getPublishedPosts(LOCALE.en));
  return tags.map(tag => ({ params: { tag: tag.slug }, props: { tag } }));
};

interface Props {
  tag: Tag;
}

const { tag } = Astro.props;
---

<TagView locale={LOCALE.en} tag={tag} />
