---
import '@/styles/global.css';
import ActionRow from '@giancastle/ui/components/ActionRow.astro';
import Closer from '@giancastle/ui/components/Closer.astro';
import Masthead from '@giancastle/ui/components/Masthead.astro';
import SectionPlate from '@giancastle/ui/components/SectionPlate.astro';
import { plateHeading, plateLabels, plateSiteLinks } from '@giancastle/ui/site-plate';
import PatternStrip from '@giancastle/ui/components/PatternStrip.astro';
import SiteHead from '@giancastle/ui/components/SiteHead.astro';
import SocialLinks from '@giancastle/ui/components/SocialLinks.astro';
import {
  fallbackPage,
  otherLocale,
  type Locale,
  type LocaleAlternate,
} from '@giancastle/ui/locale';
import { OG_TYPE, type OgType } from '@giancastle/ui/site-head';
import { AUTHOR, SITE, siteHref } from '@giancastle/ui/sites';
import { SITE_COPY } from '@/site.labels';
import { DEFAULT_LOCALE } from '@/i18n';
import { routesFor } from '@/routes';

interface Props {
  locale: Locale;
  alternate?: LocaleAlternate;
  title?: string;
  description?: string;
  image?: URL;
  jsonLd?: Record<string, unknown>;
  ogType?: OgType;
  masthead?: boolean;
}

const { locale, title, image, jsonLd, ogType = OG_TYPE.website, masthead = true } = Astro.props;
const copy = SITE_COPY[locale];
const routes = routesFor(locale);
const { description = copy.description } = Astro.props;
const alternate =
  Astro.props.alternate ?? fallbackPage(otherLocale(locale), routesFor(otherLocale(locale)).home);

const pageTitle = title ? `${title} · ${copy.title}` : copy.title;
const year = new Date().getFullYear();
const navLinks = [
  { label: copy.navBlog, href: routes.home },
  { label: copy.navRss, href: routes.rss },
  { label: copy.about, href: siteHref(SITE.web, locale) },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <SiteHead
      locale={locale}
      defaultLocale={DEFAULT_LOCALE}
      alternate={alternate}
      title={pageTitle}
      ogTitle={title ?? copy.title}
      description={description}
      siteName={copy.title}
      ogType={ogType}
      image={image}
      jsonLd={jsonLd}
    >
      <link rel="alternate" type="application/rss+xml" title={copy.title} href={routes.rss} />
    </SiteHead>
  </head>
  <body>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-canvas focus:px-3 focus:py-2"
    >
      {copy.skipToContent}
    </a>
    {masthead && (
      <Masthead
        wordmark={AUTHOR.handle}
        eyebrow={copy.lockupLead}
        href={routes.home}
        links={navLinks}
        locale={locale}
        alternate={alternate}
      />
    )}
    <SectionPlate
      labels={plateLabels(locale)}
      heading={plateHeading(SITE.blog, locale)}
      links={plateSiteLinks(SITE.blog, locale)}
    />
    <main id="content">
      <slot />
    </main>
    <PatternStrip />
    <Closer
      site={SITE.blog}
      locale={locale}
      title={copy.closerTitle}
      tagline={copy.closerTagline}
      note={`${copy.title} © ${year} · Breathe in life.`}
    >
      <ActionRow>
        <SocialLinks />
        <a href={routes.rss}>{copy.navRss}</a>
      </ActionRow>
    </Closer>
  </body>
</html>
