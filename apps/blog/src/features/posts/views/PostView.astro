---
import Band from '@giancastle/ui/components/Band.astro';
import Heavy from '@giancastle/ui/components/Heavy.astro';
import Sticker from '@giancastle/ui/components/Sticker.astro';
import StickyLabel from '@giancastle/ui/components/StickyLabel.astro';
import { OG_TYPE } from '@giancastle/ui/site-head';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routesFor } from '@/routes';
import PostMeta from '../components/PostMeta.astro';
import CategoryLabel from '../components/CategoryLabel.astro';
import { buildPostJsonLd } from '../post.jsonld';
import { POSTS_COPY } from '../posts.labels';
import { getPostAlternate, type Post } from '../posts.query';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const copy = POSTS_COPY[post.locale];
const routes = routesFor(post.locale);
const alternate = await getPostAlternate(post);
const { Content } = await render(post);
const socialImage = await getImage({
  src: post.data.image,
  width: 1200,
  height: 630,
  format: 'jpg',
});
const imageUrl = new URL(socialImage.src, Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---

<BaseLayout
  locale={post.locale}
  alternate={alternate}
  title={post.data.title}
  description={post.excerpt}
  image={imageUrl}
  ogType={OG_TYPE.article}
  jsonLd={buildPostJsonLd(post, pageUrl, imageUrl)}
>
  <article>
    <Band as="header" tone="contrast" size="compact">
      <div class="flex flex-col gap-6">
        <CategoryLabel category={post.data.category} locale={post.locale} />
        <Heavy as="h1" size="title">
          {post.data.title}
        </Heavy>
        <PostMeta post={post} />
      </div>
    </Band>
    <Band as="div" size="compact">
      <div class="mx-auto w-full max-w-5xl">
        <Sticker as="figure" tilt="right" padding="tight">
          <Image
            src={post.data.image}
            alt=""
            width={1600}
            height={900}
            loading="eager"
            class="aspect-[16/9] w-full object-cover"
          />
        </Sticker>
      </div>
      {post.data.translated && (
        <p class="mx-auto mt-10 w-full max-w-[42rem]">
          <StickyLabel color="teal">
            {copy.translatedNote}{' '}
            <a href={alternate.href} hreflang={alternate.locale}>
              {copy.readOriginal}
            </a>
          </StickyLabel>
        </p>
      )}
      <div class="prose mx-auto mt-10 w-full max-w-[42rem]">
        <Content />
      </div>
      <p class="rule-top mx-auto mt-16 w-full max-w-[42rem] pt-6">
        <a href={routes.home} class="label no-underline hover:text-accent">
          ← {copy.backHome}
        </a>
      </p>
    </Band>
  </article>
</BaseLayout>
