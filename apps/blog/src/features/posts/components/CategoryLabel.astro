---
import type { Locale } from '@giancastle/ui/locale';
import SteamingCup from './SteamingCup.astro';
import {
  CATEGORY,
  CATEGORY_COLOR,
  CATEGORY_FILL_OF,
  CATEGORY_LABEL,
  categoryHref,
  type Category,
} from '../posts.categories';

interface Props {
  category: Category;
  locale: Locale;
  taped?: boolean;
}

const { category, locale, taped = false } = Astro.props;
const label = CATEGORY_LABEL[locale][category];
const color = CATEGORY_COLOR[category];
---

<a
  href={categoryHref(category, locale)}
  class:list={['label', 'category', CATEGORY_FILL_OF[category], { taped }]}
  data-decal={color}
>
  {category === CATEGORY.coffee && <SteamingCup />}
  {label}
</a>

<style>
  .category {
    display: inline-block;
    width: fit-content;
    padding: 0.5em 0.8em 0.45em;
    border: 2px solid var(--decal);
    text-decoration: none;
    rotate: -2deg;
    transition: rotate 200ms;
  }

  .category:hover {
    rotate: 0deg;
  }

  .solid {
    background: var(--decal);
    color: var(--pop-fg);
  }

  .outline {
    background: var(--bg);
    color: var(--decal-tint);
  }

  .taped {
    position: absolute;
    z-index: 1;
    left: -0.5rem;
    top: 0.9rem;
    rotate: -3deg;
  }
</style>
