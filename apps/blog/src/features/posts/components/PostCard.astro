---
import Heavy from '@giancastle/ui/components/Heavy.astro';
import { Image } from 'astro:assets';
import { CATEGORY_COLOR } from '../posts.categories';
import type { Post } from '../posts.query';
import CategoryLabel from './CategoryLabel.astro';
import PostMeta from './PostMeta.astro';

interface Props {
  post: Post;
  wide?: boolean;
}

const { post, wide = false } = Astro.props;
const { href } = post;
const { category } = post.data;
---

<article class:list={['card group', { wide }]} data-decal={CATEGORY_COLOR[category]}>
  <div class="relative">
    <CategoryLabel category={category} locale={post.locale} taped />
    <a href={href} tabindex="-1" aria-hidden="true" class="photo bg-surface">
      <Image
        src={post.data.image}
        alt=""
        width={wide ? 1200 : 720}
        height={wide ? 800 : 480}
        loading="lazy"
        class="aspect-[3/2] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
      />
    </a>
  </div>
  <div class="body">
    <a href={href} class="no-underline hover:text-accent">
      <Heavy as="h2" size={wide ? 'step' : 'card'}>
        {post.data.title}
      </Heavy>
    </a>
    <p class:list={['text-muted', wide ? 'text-xl' : 'text-base']}>{post.excerpt}</p>
    <PostMeta post={post} />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .photo {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--decal);
    mix-blend-mode: multiply;
    opacity: 0.4;
    transition: opacity 300ms;
  }

  .card:hover .photo::after {
    opacity: 0;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 3px solid var(--decal);
  }

  @media (min-width: 40rem) {
    .wide {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
      gap: 2.5rem;
    }
  }
</style>
