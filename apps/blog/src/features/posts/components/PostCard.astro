---
import Heavy from '@giancastle/ui/components/Heavy.astro';
import { Image } from 'astro:assets';
import { routesFor } from '@/routes';
import { excerpt } from '../posts.format';
import type { Post } from '../posts.query';
import PostMeta from './PostMeta.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const href = routesFor(post.locale).post(post.slug);
---

<article
  lang={post.locale}
  class:list={[
    'group flex flex-col gap-5',
    featured && 'md:grid md:grid-cols-[1.25fr_1fr] md:items-end md:gap-10',
  ]}
>
  <a href={href} tabindex="-1" aria-hidden="true" class="block overflow-hidden bg-surface">
    <Image
      src={post.data.image}
      alt=""
      width={featured ? 1200 : 720}
      height={featured ? 800 : 480}
      loading={featured ? 'eager' : 'lazy'}
      class="aspect-[3/2] w-full object-cover grayscale transition duration-500 group-hover:grayscale-0"
    />
  </a>
  <div class="rule-top flex flex-col gap-4 pt-4">
    <TagList tags={post.data.tags} locale={post.locale} />
    <a href={href} class="no-underline hover:text-accent">
      <Heavy as="h2" size={featured ? 'title' : 'card'}>
        {post.data.title}
      </Heavy>
    </a>
    <p class:list={['text-muted', featured ? 'text-xl' : 'text-base']}>
      {excerpt(post.body ?? '')}
    </p>
    <PostMeta post={post} />
  </div>
</article>
