---
import '@/styles/global.css';
import SiteHead from '@giancastle/ui/components/SiteHead.astro';
import type { Locale, LocaleAlternate } from '@giancastle/ui/locale';
import { OG_TYPE } from '@giancastle/ui/site-head';
import { AUTHOR } from '@giancastle/ui/sites';
import type { Theme } from '@giancastle/ui/theme';
import { PROFILE_CONTENT } from '@/features/profile/profile.content';
import { DEFAULT_LOCALE } from '@/i18n';
import { LLMS_PATH } from '@/routes';

interface Props {
  locale?: Locale;
  alternate?: LocaleAlternate;
  title?: string;
  forceTheme?: Theme;
  jsonLd?: Record<string, unknown>;
}

const { locale = DEFAULT_LOCALE, alternate, title, forceTheme, jsonLd } = Astro.props;
const { profile } = PROFILE_CONTENT[locale];

const siteTitle = `${AUTHOR.name} · ${profile.role}`;
const pageTitle = title ? `${title} · ${AUTHOR.name}` : siteTitle;
---

<!doctype html>
<html lang={locale}>
  <head>
    <SiteHead
      locale={locale}
      defaultLocale={DEFAULT_LOCALE}
      alternate={alternate}
      title={pageTitle}
      description={profile.description}
      siteName={AUTHOR.name}
      ogType={OG_TYPE.profile}
      forceTheme={forceTheme}
      jsonLd={jsonLd}
    >
      <link rel="alternate" type="text/plain" title="llms.txt" href={LLMS_PATH} />
    </SiteHead>
  </head>
  <body>
    <slot />
  </body>
</html>
